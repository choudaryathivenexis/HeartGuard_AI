{
  // Pin the interpreter to the project venv.
  //
  // This matters as much as the launch config. The `python` first on PATH on this
  // machine is a system 3.14 install WITHOUT matplotlib, scikit-learn, xgboost or
  // shap, so running the app under it dies immediately with
  // `ModuleNotFoundError: No module named 'matplotlib'`. The venv is the only
  // interpreter that satisfies requirements.txt — including scikit-learn 1.9.0, which
  // the pickled models in models/ require.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // The tests are plain scripts, not pytest suites — they run standalone by design so
  // the gate does not depend on a runner that is absent from requirements.txt.
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,

  "files.exclude": {
    "**/__pycache__": true
  }
}
